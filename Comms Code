import { useState, useEffect } from "react";

const USD_TO_AUD = 1.55;

function formatAUD(val) {
  return new Intl.NumberFormat("en-AU", {
    style: "currency",
    currency: "AUD",
    maximumFractionDigits: 0,
  }).format(val);
}

function getTier(spendAUD) {
  if (spendAUD >= 15000) return { label: "Tier 1", color: "#566fff", bg: "#eef0ff" };
  if (spendAUD >= 5000) return { label: "Tier 2", color: "#00d8cb", bg: "#e0faf8" };
  return { label: "Tier 3", color: "#04060d", bg: "#eef0ff" };
}

function getBlendFee(spendAUD) {
  if (spendAUD <= 15000) return spendAUD * 0.10;
  if (spendAUD <= 50000) return 15000 * 0.10 + (spendAUD - 15000) * 0.07;
  return 15000 * 0.10 + 35000 * 0.07 + (spendAUD - 50000) * 0.02;
}

function Pill({ label, color, bg }) {
  return (
    <span style={{
      display: "inline-block",
      padding: "3px 10px",
      borderRadius: "20px",
      fontSize: "11px",
      fontWeight: "700",
      letterSpacing: "0.06em",
      background: bg,
      color: color,
      textTransform: "uppercase",
    }}>{label}</span>
  );
}

function Toggle({ label, checked, onChange }) {
  return (
    <label style={{
      display: "flex",
      alignItems: "center",
      justifyContent: "space-between",
      cursor: "pointer",
      padding: "11px 14px",
      background: checked ? "#eef0ff" : "#ffffff",
      border: `1.5px solid ${checked ? "#566fff" : "#e8eaf0"}`,
      borderRadius: "8px",
      transition: "all 0.15s",
    }}>
      <span style={{ fontSize: "13px", color: checked ? "#566fff" : "#6b7280", fontWeight: "500", fontFamily: "'DM Sans', sans-serif" }}>{label}</span>
      <div style={{
        width: "36px", height: "20px",
        background: checked ? "#566fff" : "#d1d5db",
        borderRadius: "10px",
        position: "relative",
        transition: "background 0.2s",
        flexShrink: 0,
      }}>
        <div style={{
          position: "absolute",
          top: "2px",
          left: checked ? "18px" : "2px",
          width: "16px", height: "16px",
          background: "#ffffff",
          borderRadius: "50%",
          transition: "left 0.2s",
          boxShadow: "0 1px 3px rgba(0,0,0,0.15)",
        }} />
      </div>
    </label>
  );
}

function LineItem({ label, value, accent, large, muted }) {
  return (
    <div style={{
      display: "flex",
      justifyContent: "space-between",
      alignItems: "center",
      padding: large ? "8px 0" : "6px 0",
      borderBottom: "1px solid #f0f2f7",
    }}>
      <span style={{
        fontSize: large ? "13px" : "12px",
        color: muted ? "#c0c4d0" : "#6b7280",
        fontWeight: "500",
        fontFamily: "'DM Sans', sans-serif",
      }}>{label}</span>
      <span style={{
        fontSize: large ? "15px" : "13px",
        color: accent || (large ? "#04060d" : "#374151"),
        fontWeight: large ? "700" : "500",
        fontFamily: "'DM Mono', monospace",
      }}>{value}</span>
    </div>
  );
}

export default function CommissionCalc() {
  const [currency, setCurrency] = useState("AUD");
  const [rawSpend, setRawSpend] = useState("");
  const [month2Spend, setMonth2Spend] = useState("");
  const [useMonth2, setUseMonth2] = useState(false);
  const [isOutbound, setIsOutbound] = useState(false);
  const [isWinback, setIsWinback] = useState(false);
  const [isChurnSave, setIsChurnSave] = useState(false);
  const [animate, setAnimate] = useState(false);

  const spend1 = parseFloat(rawSpend) || 0;
  const spend2 = useMonth2 ? (parseFloat(month2Spend) || spend1) : spend1;

  const toAUD = (v) => currency === "USD" ? v * USD_TO_AUD : v;

  const spend1AUD = toAUD(spend1);
  const spend2AUD = toAUD(spend2);
  const avgSpendAUD = (spend1AUD + spend2AUD) / 2;

  const tier = getTier(avgSpendAUD);
  const isT3 = tier.label === "Tier 3";

  const fee1 = getBlendFee(spend1AUD);
  const fee2 = getBlendFee(spend2AUD);
  const avgFee = (fee1 + fee2) / 2;

  let baseComm = isT3 ? 150 : avgFee * 0.5;
  let outboundBonus = (!isWinback && isOutbound && !isT3) ? 500 : 0;
  let churnBonus = isChurnSave ? 500 : 0;
  let total = baseComm + outboundBonus + churnBonus;

  const hasSpend = spend1 > 0;

  useEffect(() => {
    if (hasSpend) {
      setAnimate(true);
      const t = setTimeout(() => setAnimate(false), 300);
      return () => clearTimeout(t);
    }
  }, [spend1, spend2, isOutbound, isWinback, isChurnSave, useMonth2]);

  return (
    <div style={{
      minHeight: "100vh",
      background: "#f5f6fb",
      display: "flex",
      alignItems: "flex-start",
      justifyContent: "center",
      padding: "40px 16px",
      fontFamily: "'DM Sans', sans-serif",
    }}>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=DM+Sans:wght@400;500;600;700&display=swap');
        * { box-sizing: border-box; margin: 0; padding: 0; }
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; }
        input[type=number] { -moz-appearance: textfield; }
        .calc-input:focus { outline: none; border-color: #566fff !important; box-shadow: 0 0 0 3px #566fff22; }
        .calc-input::placeholder { color: #c8ccd8; }
        .result-flash { animation: flash 0.3s ease; }
        @keyframes flash { 0% { opacity: 0.5; transform: translateY(4px); } 100% { opacity: 1; transform: translateY(0); } }
      `}</style>

      <div style={{ width: "100%", maxWidth: "420px" }}>

        {/* Header */}
        <div style={{ marginBottom: "28px" }}>
          <div style={{ display: "flex", alignItems: "center", gap: "8px", marginBottom: "8px" }}>
            <div style={{
              background: "#566fff",
              borderRadius: "6px",
              padding: "4px 10px",
              display: "inline-flex",
              alignItems: "center",
              gap: "6px",
            }}>
              <div style={{ width: "6px", height: "6px", borderRadius: "50%", background: "#00d8cb" }} />
              <span style={{ fontSize: "10px", letterSpacing: "0.15em", color: "#ffffff", textTransform: "uppercase", fontWeight: "600" }}>
                Blend AI
              </span>
            </div>
          </div>
          <h1 style={{
            fontSize: "24px",
            fontWeight: "700",
            color: "#04060d",
            letterSpacing: "-0.02em",
            lineHeight: 1.2,
          }}>Commission Calculator</h1>
          <p style={{ fontSize: "12px", color: "#9ca3af", marginTop: "4px" }}>FY2026 · GOD doc structure</p>
        </div>

        {/* Currency Toggle */}
        <div style={{
          display: "flex",
          background: "#ffffff",
          border: "1.5px solid #e8eaf0",
          borderRadius: "10px",
          marginBottom: "20px",
          overflow: "hidden",
          padding: "4px",
          gap: "4px",
        }}>
          {["AUD", "USD"].map(c => (
            <button key={c} onClick={() => setCurrency(c)} style={{
              flex: 1,
              padding: "8px",
              background: currency === c ? "#566fff" : "transparent",
              border: "none",
              borderRadius: "7px",
              color: currency === c ? "#ffffff" : "#9ca3af",
              fontSize: "12px",
              fontWeight: "600",
              cursor: "pointer",
              letterSpacing: "0.06em",
              fontFamily: "'DM Sans', sans-serif",
              transition: "all 0.15s",
            }}>{c}{c === "USD" ? " → AUD" : ""}</button>
          ))}
        </div>

        {/* Spend Inputs */}
        <div style={{ marginBottom: "14px" }}>
          <label style={{ fontSize: "11px", color: "#9ca3af", letterSpacing: "0.1em", textTransform: "uppercase", display: "block", marginBottom: "6px", fontWeight: "600" }}>
            Month 1 Ad Spend ({currency})
          </label>
          <div style={{ position: "relative" }}>
            <span style={{
              position: "absolute", left: "13px", top: "50%", transform: "translateY(-50%)",
              color: "#9ca3af", fontSize: "14px", fontFamily: "'DM Mono', monospace",
            }}>{currency === "USD" ? "$" : "A$"}</span>
            <input
              className="calc-input"
              type="number"
              value={rawSpend}
              onChange={e => setRawSpend(e.target.value)}
              placeholder="0"
              style={{
                width: "100%",
                background: "#ffffff",
                border: "1.5px solid #e8eaf0",
                borderRadius: "8px",
                padding: "12px 13px 12px 36px",
                color: "#04060d",
                fontSize: "16px",
                fontFamily: "'DM Mono', monospace",
                transition: "border 0.15s, box-shadow 0.15s",
              }}
            />
          </div>
        </div>

        <div style={{ marginBottom: "14px" }}>
          <Toggle label="Enter Month 2 spend separately" checked={useMonth2} onChange={() => setUseMonth2(v => !v)} />
        </div>

        {useMonth2 && (
          <div style={{ marginBottom: "14px" }}>
            <label style={{ fontSize: "11px", color: "#9ca3af", letterSpacing: "0.1em", textTransform: "uppercase", display: "block", marginBottom: "6px", fontWeight: "600" }}>
              Month 2 Ad Spend ({currency})
            </label>
            <div style={{ position: "relative" }}>
              <span style={{
                position: "absolute", left: "13px", top: "50%", transform: "translateY(-50%)",
                color: "#9ca3af", fontSize: "14px", fontFamily: "'DM Mono', monospace",
              }}>{currency === "USD" ? "$" : "A$"}</span>
              <input
                className="calc-input"
                type="number"
                value={month2Spend}
                onChange={e => setMonth2Spend(e.target.value)}
                placeholder="0"
                style={{
                  width: "100%",
                  background: "#ffffff",
                  border: "1.5px solid #e8eaf0",
                  borderRadius: "8px",
                  padding: "12px 13px 12px 36px",
                  color: "#04060d",
                  fontSize: "16px",
                  fontFamily: "'DM Mono', monospace",
                  transition: "border 0.15s, box-shadow 0.15s",
                }}
              />
            </div>
          </div>
        )}

        {/* Toggles */}
        <div style={{ display: "flex", flexDirection: "column", gap: "6px", marginBottom: "20px" }}>
          <Toggle label="Outbound deal" checked={isOutbound} onChange={() => setIsOutbound(v => !v)} />
          <Toggle label="Win-back (90+ days inactive)" checked={isWinback} onChange={() => setIsWinback(v => !v)} />
          <Toggle label="Churn save" checked={isChurnSave} onChange={() => setIsChurnSave(v => !v)} />
        </div>

        {/* Results Card */}
        <div className={animate ? "result-flash" : ""} style={{
          background: "#ffffff",
          border: "1.5px solid #e8eaf0",
          borderRadius: "12px",
          padding: "20px",
          boxShadow: "0 2px 16px rgba(86,111,255,0.06)",
        }}>
          <div style={{ display: "flex", justifyContent: "space-between", alignItems: "center", marginBottom: "16px" }}>
            <span style={{ fontSize: "11px", color: "#9ca3af", letterSpacing: "0.1em", textTransform: "uppercase", fontWeight: "600" }}>Breakdown</span>
            {hasSpend && <Pill label={tier.label} color={tier.color} bg={tier.bg} />}
          </div>

          {hasSpend ? (
            <>
              {currency === "USD" && (
                <LineItem label="Avg spend (converted to AUD)" value={formatAUD(avgSpendAUD)} muted />
              )}
              {!isT3 && (
                <>
                  <LineItem label="Avg monthly Blend fee" value={formatAUD(avgFee)} />
                  <LineItem label="Commission rate" value="50%" />
                </>
              )}
              {isT3 && (
                <LineItem label="Tier 3 flat fee" value={formatAUD(150)} />
              )}
              {outboundBonus > 0 && (
                <LineItem label="Outbound bonus" value={`+ ${formatAUD(outboundBonus)}`} accent="#566fff" />
              )}
              {churnBonus > 0 && (
                <LineItem label="Churn save bonus" value={`+ ${formatAUD(churnBonus)}`} accent="#00d8cb" />
              )}
              {isWinback && isOutbound && (
                <LineItem label="Win-back note" value="No outbound bonus" muted />
              )}

              <div style={{
                marginTop: "16px",
                paddingTop: "16px",
                borderTop: "2px solid #eef0ff",
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
              }}>
                <span style={{ fontSize: "12px", color: "#6b7280", fontWeight: "600", textTransform: "uppercase", letterSpacing: "0.08em" }}>Total Commission</span>
                <span style={{
                  fontSize: "28px",
                  fontWeight: "700",
                  color: "#566fff",
                  fontFamily: "'DM Mono', monospace",
                  letterSpacing: "-0.02em",
                }}>{formatAUD(total)}</span>
              </div>

              <p style={{ marginTop: "10px", fontSize: "11px", color: "#c0c4d0", lineHeight: "1.5" }}>
                Paid after 2 invoices. All amounts AUD. USD converted at ~{USD_TO_AUD}x.
              </p>
            </>
          ) : (
            <div style={{ textAlign: "center", padding: "24px 0" }}>
              <div style={{ fontSize: "28px", marginBottom: "8px" }}>💰</div>
              <span style={{ fontSize: "13px", color: "#c0c4d0" }}>Enter ad spend to calculate</span>
            </div>
          )}
        </div>

        {/* Fee Scale */}
        <div style={{
          marginTop: "14px",
          padding: "14px 16px",
          background: "#eef0ff",
          borderRadius: "8px",
        }}>
          <p style={{ fontSize: "10px", color: "#566fff", letterSpacing: "0.1em", textTransform: "uppercase", marginBottom: "8px", fontWeight: "700" }}>Blend fee scale</p>
          <div style={{ display: "flex", flexDirection: "column", gap: "4px" }}>
            {[["$0 – $15K", "10%"], ["$15K – $50K", "7%"], ["$50K+", "2%"]].map(([range, rate]) => (
              <div key={range} style={{ display: "flex", justifyContent: "space-between" }}>
                <span style={{ fontSize: "12px", color: "#7c87c0" }}>{range}</span>
                <span style={{ fontSize: "12px", color: "#566fff", fontFamily: "'DM Mono', monospace", fontWeight: "600" }}>{rate}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
  );
}
